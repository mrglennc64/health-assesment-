GOOGLE_AI_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# OpenRouter (OpenAI-compatible aggregator). See lib/openrouterClient.ts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral AI (chat completions). See lib/mistralClient.ts.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Per-channel provider override. Picks which provider to TRY FIRST for that
# channel (cross-provider fallback still kicks in on 429). Values:
# gemini | openrouter | mistral. If unset, defaults to first configured
# provider in order: mistral, openrouter, gemini.
# CLINICAL_PROVIDER=mistral
# HIPAA_PROVIDER=mistral
# CLAIMS_PROVIDER=openrouter
# COMMUNICATION_PROVIDER=openrouter
# CONTENT_PROVIDER=gemini
# SYNTHETIC_PROVIDER=gemini
